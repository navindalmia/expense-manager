// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
//  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------- ENUMS --------------------
enum SplitType {
  EQUAL
  AMOUNT
  PERCENTAGE
}

// -------------------- USER --------------------
model User {
  id                     Int       @id @default(autoincrement())
  name                   String
  email                  String?   @unique  // Optional - user can be invited before registering
  password               String?   // bcrypt hashed password (optional for compatibility)
  emailVerified          Boolean   @default(false)
  emailVerifiedAt        DateTime?
  isActive               Boolean   @default(true)
  lastLogin              DateTime?
  failedLoginAttempts    Int       @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())
  
  expensesPaid           Expense[] @relation("PaidBy")
  groupsCreated          Group[]   @relation("GroupCreatedBy")
  groupsMember           Group[]   @relation("GroupMembers")
  expensesSplit          Expense[] @relation("ExpenseSplitWith")
  verificationTokens     EmailVerificationToken[]
  themes                 Theme[]
  categories             Category[]
  labels                 Label[]
}

// -------------------- EMAIL VERIFICATION TOKEN --------------------
model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  
  @@index([userId])
  @@index([expiresAt])
}

// -------------------- CATEGORY --------------------
model Category {
  id        Int       @id @default(autoincrement())
  code      String    @unique           // e.g., FOOD, TRAVEL
  label     String                         // e.g., "Food", "Travel"
  userId    Int?      // null = system/global (seeded defaults); set = user-created custom category
  user      User?     @relation(fields: [userId], references: [id])
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]
  suggestedInAudits CategorySuggestionAudit[] @relation("SuggestedCategory")
  acceptedInAudits  CategorySuggestionAudit[] @relation("AcceptedCategory")

  @@index([userId])
}

// -------------------- THEME (Group-level, reusable) --------------------
model Theme {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int?     // null = system/global; set = user-created
  user      User?    @relation(fields: [userId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  groups    Group[]

  @@index([userId])
}

// -------------------- LABEL (Expense-level, cross-group, free-text) --------------------
model Label {
  id        Int       @id @default(autoincrement())
  name      String
  userId    Int?      // null = system/global (unused in v1 -- all labels are user-created)
  user      User?     @relation(fields: [userId], references: [id])
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@index([userId])
}

// -------------------- CATEGORY SUGGESTION AUDIT --------------------
// Logs every keyword-dictionary category suggestion and what the user
// ultimately chose, to build a labeled dataset for a possible future
// graduation to a smarter suggestion mechanism (see KTD3/KTD10 in
// docs/plans/2026-08-31-001-feat-intelligence-layer-themes-labels-autocomplete-plan.md).
model CategorySuggestionAudit {
  id                  Int      @id @default(autoincrement())
  expenseId           Int
  expense             Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  suggestedCategoryId Int
  suggestedCategory   Category @relation("SuggestedCategory", fields: [suggestedCategoryId], references: [id])
  acceptedCategoryId  Int
  acceptedCategory    Category @relation("AcceptedCategory", fields: [acceptedCategoryId], references: [id])
  titleText           String
  createdAt           DateTime @default(now())

  @@index([expenseId])
}

// -------------------- CURRENCY --------------------
model Currency {
  id       Int       @id @default(autoincrement())
  code     String    @unique           // e.g., GBP, USD, EUR (ISO 4217 code)
  label    String                      // e.g., "British Pound", "US Dollar"
  expenses Expense[]
  groups   Group[]
}

// -------------------- GROUP (List/Trip/Month) --------------------
model Group {
  id          Int       @id @default(autoincrement())
  name        String    // e.g., "March 2024", "Paris Trip", "House Budget"
  description String?   // Optional: trip description or purpose
  createdBy   User      @relation("GroupCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdById Int
  members     User[]    @relation("GroupMembers") // Users in this group
  expenses    Expense[]
  currency    Currency  @relation(fields: [currencyId], references: [id])
  currencyId  Int       // Foreign key to Currency
  theme       Theme?    @relation(fields: [themeId], references: [id])
  themeId     Int?      // Optional -- links groups across time (e.g. "Monthly Expense" reused every month)
  isActive    Boolean   @default(true) // Soft delete flag
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([createdById])
  @@index([currencyId])
  @@index([isActive])
  @@index([themeId])
}

// -------------------- EXPENSE --------------------
model Expense {
  id           Int       @id @default(autoincrement())
  title        String
  amount       Float
  currency     Currency  @relation(fields: [currencyId], references: [id])
  currencyId   Int       // Foreign key to Currency
  paidBy       User      @relation("PaidBy", fields: [paidById], references: [id], onDelete: Cascade)
  paidById     Int
  group        Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId      Int
  splitWith    User[]    @relation("ExpenseSplitWith") // implicit many-to-many join table created by Prisma
  splitAmount  Float[]   // meaningful if splitType = AMOUNT
  splitPercentage Float[] // meaningful if splitType = PERCENTAGE
  splitType    SplitType @default(EQUAL)
  category     Category  @relation(fields: [categoryId], references: [id])
  categoryId   Int
  label        Label?    @relation(fields: [labelId], references: [id])
  labelId      Int?      // Optional -- free-text, cross-group tag (e.g. "Liverpool")
  notes        String?
  expenseDate  DateTime  @default(now())  // Defaults to today's date (current timestamp)
  isSettled    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  suggestionAudits CategorySuggestionAudit[]

  @@index([groupId])
  @@index([paidById])
  @@index([currencyId])
  @@index([expenseDate])
  @@index([labelId])
}



