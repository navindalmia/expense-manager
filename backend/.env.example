# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env.local and fill in actual values
# NEVER commit .env.local - it contains secrets

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://admin:admin123@localhost:5432/expense_db?schema=public

# ============================================
# JWT Authentication
# ============================================
# REQUIRED, minimum 32 characters. The server refuses to start without it (no default).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=24h

# ============================================
# Email Service (SendGrid for production)
# ============================================
# Production: Use SendGrid
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Development fallback: Use Ethereal (optional, for testing)
# Create account: https://ethereal.email/
# ETHEREAL_USER=your_ethereal_user@ethereal.email
# ETHEREAL_PASS=your_ethereal_password

# Set to "false" to let users log in / use the app without verifying their email
# (e.g. while no email provider is configured). Defaults to required (true) when unset.
REQUIRE_EMAIL_VERIFICATION=true

# ============================================
# Frontend URLs & App Configuration
# ============================================
# Used in email verification links and deep linking
APP_FRONTEND_URL=http://localhost:8081
# Deep link scheme for mobile app (change this if app name changes on PlayStore)
APP_SCHEME=expensemanager://
# App display name (used in emails, notifications, etc.)
APP_NAME=Expense Manager

# ============================================
# Environment
# ============================================
NODE_ENV=development
PORT=4000

# ============================================
# Hardening
# ============================================
# Comma-separated browser origins allowed by CORS. Unset: Expo web dev origins
# (http://localhost:8081, http://localhost:19006) outside production, none in
# production. Wildcards are ignored. Native apps send no Origin and are unaffected.
# CORS_ORIGINS=https://your-web-app.example

# Proxy hops to trust for client IP (rate limiting). Default: 1 in production
# (Render's proxy), none elsewhere.
# TRUST_PROXY=1

# Internal test-support routes (/api/internal/*). Mounted only when
# NODE_ENV != production AND this is exactly "true". Needed only by tooling
# that calls them (e.g. the on-hold Maestro email-verification flows).
# ENABLE_INTERNAL_ROUTES=true

# ============================================
# Rate limiting (per client IP; resend-verification per email)
# ============================================
# Set to "true" to disable limiting (CI / e2e). Ignored when NODE_ENV=production.
# RATE_LIMIT_DISABLED=true
# Defaults shown. <NAME> = LOGIN | SIGNUP | VERIFY_EMAIL | RESEND_VERIFICATION
#   RATE_LIMIT_LOGIN_MAX=10                 RATE_LIMIT_LOGIN_WINDOW_MS=900000
#   RATE_LIMIT_SIGNUP_MAX=5                 RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
#   RATE_LIMIT_VERIFY_EMAIL_MAX=10          RATE_LIMIT_VERIFY_EMAIL_WINDOW_MS=3600000
#   RATE_LIMIT_RESEND_VERIFICATION_MAX=5    RATE_LIMIT_RESEND_VERIFICATION_WINDOW_MS=3600000
#   RATE_LIMIT_RESEND_VERIFICATION_IP_MAX=20  RATE_LIMIT_RESEND_VERIFICATION_IP_WINDOW_MS=3600000
