# Template only — this file is committed and never read directly by the app.
#
# Real env files, in Expo's actual load order (highest precedence wins):
#   .env.development.local   personal override, gitignored, e.g. your LAN IP for a physical device
#   .env.local                personal override, gitignored, applies regardless of mode
#   .env.development           committed shared default (Android emulator / CI, see this file's twin)
#   .env                       committed base fallback (lowest precedence — not currently used)
#
# For local dev against the Android emulator or CI/Maestro: .env.development already
# has a working default (10.0.2.2 — the emulator's host-loopback address). You don't
# need to create anything.
#
# For a physical device: copy this into .env.development.local and set it to your
# machine's actual LAN IP (find it with `ipconfig getifaddr en0` on Mac):
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api
