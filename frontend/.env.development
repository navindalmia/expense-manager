# Committed, safe default for local development and CI/Maestro (Android emulator + CI runner).
# Loaded automatically by Expo's dotenv resolution whenever NODE_ENV=development
# (the default for `expo start` / `expo run:android` / `expo prebuild`).
#
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost —
# it is NOT a real network address and needs no personal LAN IP.
# iOS Simulator can reach the host directly via localhost, so this same value
# also works when EXPO_PUBLIC_API_BASE_URL is read on iOS (Metro serves one
# bundle; the value isn't platform-branched here — see ENVIRONMENT_SETUP.md
# if that ever needs to change).
#
# Do NOT put a personal LAN IP or secret here — this file is committed.
# For a physical device (needs your machine's real LAN IP) or any other
# personal override, create .env.development.local instead (gitignored,
# highest precedence, never committed).
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000/api
