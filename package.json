{
  "name": "expense-manager",
  "version": "0.4.0",
  "description": "Expense management application with Expo frontend and Express backend",
  "scripts": {
    "start": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && npm run dev",
    "frontend:dev": "cd frontend && npm start",
    "test:backend": "cd backend && npm test",
    "test:frontend": "cd frontend && npm test -- --run",
    "test:regression": "node scripts/regression-gate.js suites",
    "test:gate": "node --test scripts/__tests__/regression-gate.test.js scripts/__tests__/regression-gate-r2.test.js scripts/__tests__/regression-gate-r3.test.js",
    "hooks:install": "node scripts/install-hooks.js",
    "prepare": "node scripts/install-hooks.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.5"
  }
}
