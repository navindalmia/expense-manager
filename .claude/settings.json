{
  "permissions": {
    "allow": [
      "PowerShell(git -C *)",
      "PowerShell(docker exec *)",
      "PowerShell(docker ps *)",
      "PowerShell(docker logs *)",
      "PowerShell(docker images *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Item *)",
      "PowerShell(ls *)",
      "PowerShell(wsl *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Select-String *)",
      "PowerShell(jq *)",
      "WebSearch",
      "Bash(git -C *)",
      "Bash(docker exec *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker images *)",
      "Bash(jq *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npm test -- --run)",
      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__find"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\": {\"hookEventName\": \"PostToolUse\", \"additionalContext\": \"WORKFLOW GATE: Code was just edited. Before committing you MUST: STEP 1) Run npx tsc --noEmit and confirm it passes. STEP 2) Run the Compound Engineering /ce-code-review stage and get it APPROVED. STEP 3) Run frontend or backend tests as applicable. Skipping any step violates the project workflow. The next thing you should do RIGHT NOW is run tsc.\"}}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-gate.js\""
          }
        ]
      }
    ]
  }
}
